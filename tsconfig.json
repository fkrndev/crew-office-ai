{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    // Upstream's CthApi gives every bridge call a declared return type, so
    // `.then(c => ...)` callbacks stay typed. Our shim exposes the same
    // surface as `any`; without this the verbatim copies report ~100
    // implicit-any errors in callbacks. Runtime behaviour is identical.
    "noImplicitAny": false,
    // Upstream tsconfig does not flag unused locals/params — verbatim copies
    // carry a few intentionally-declared-but-unread bindings (e.g.
    // App.tsx setIdeOpen). Keep their lint contract, not ours.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["src/shared/*"],
      "@brand/*": ["docs/*"]
    }
  },
  "include": ["src"]
}
